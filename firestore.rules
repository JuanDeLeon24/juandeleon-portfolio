rules_version = '2';
// Comentarios del portafolio: máximo 4 (documentos "1" a "4"), solo creación.
// Nadie puede editar ni borrar desde la página; Juan los gestiona desde la consola de Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /testimonios/{slot} {
      allow read: if true;
      allow create: if slot in ['1', '2', '3', '4']
        && request.resource.data.keys().hasOnly(['nombre', 'profesion', 'contacto', 'mostrarContacto', 'comentario', 'fecha'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 80
        && request.resource.data.profesion is string && request.resource.data.profesion.size() >= 2 && request.resource.data.profesion.size() <= 100
        && request.resource.data.contacto is string && request.resource.data.contacto.size() <= 120
        && request.resource.data.mostrarContacto is bool
        && request.resource.data.comentario is string && request.resource.data.comentario.size() >= 10 && request.resource.data.comentario.size() <= 700
        && request.resource.data.fecha is timestamp;
      allow update, delete: if false;
    }
  }
}
